<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        x:Class="WpfApp1.MainWindow"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="400"
        Keyboard.KeyDown="Window_KeyDown">
    <Grid x:Name="mainGrid">
        <WindowsFormsHost ChildChanged="WindowsFormsHost_ChildChanged" Margin="120,577,180,107"/>
        <local:FormulaWrapper x:Name="formulaWraper" HorizontalAlignment="Center" VerticalAlignment="Top" Height="50" Width="364" Loaded="FormulaWrapper_Loaded" FontSize="18" FontFamily="Algerian" Margin="0,10,0,0"/>
        <Button x:Name="Left_Bracket" Content="(" HorizontalAlignment="Left" Margin="18,87,0,0" VerticalAlignment="Top" Width="24" Click="Button_Click"/>
        <Button x:Name="Right_Bracket" Content=")" HorizontalAlignment="Left" Margin="47,87,0,0" VerticalAlignment="Top" Width="24" Click="Button_Click"/>
        <Button x:Name="Power_2" Content="rt2" HorizontalAlignment="Left" Margin="18,112,0,0" VerticalAlignment="Top" Width="24" Click="Button_Click"/>
        <Button x:Name="Power" Content="rt" HorizontalAlignment="Left" Margin="47,112,0,0" VerticalAlignment="Top" Width="24" Click="Button_Click"/>
        <Button x:Name="Square_Root_2" Content="sq2" HorizontalAlignment="Left" Margin="18,136,0,0" VerticalAlignment="Top" Width="24" Click="Button_Click"/>
        <Button x:Name="Square_Root" Content="sq" HorizontalAlignment="Left" Margin="47,136,0,0" VerticalAlignment="Top" Width="24" Click="Button_Click"/>
        <Button x:Name="Pi" Content="pi" HorizontalAlignment="Left" Margin="18,161,0,0" VerticalAlignment="Top" Width="24" Click="Button_Click"/>
        <Button x:Name="Absolute" Content="|x|" HorizontalAlignment="Left" Margin="47,161,0,0" VerticalAlignment="Top" Width="24" Click="Button_Click"/>
        <Button x:Name="Factorial" Content="!" HorizontalAlignment="Left" Margin="18,186,0,0" VerticalAlignment="Top" Width="24" Click="Button_Click"/>
        <Button x:Name="Modulo" Content="%" HorizontalAlignment="Left" Margin="47,186,0,0" VerticalAlignment="Top" Width="24" Click="Button_Click"/>
        <Button x:Name="Plus_Minus" Content="+-" HorizontalAlignment="Left" Margin="141,87,0,0" VerticalAlignment="Top" Width="24" Click="Button_Click"/>
        <Button x:Name="Left_Arrow" Content="&lt;" HorizontalAlignment="Left" Margin="170,87,0,0" VerticalAlignment="Top" Width="24" Click="Button_Click"/>
        <Button x:Name="_7" Content="7" HorizontalAlignment="Left" Margin="141,112,0,0" VerticalAlignment="Top" Width="24" Click="Button_Click"/>
        <Button x:Name="_8" Content="8" HorizontalAlignment="Left" Margin="170,112,0,0" VerticalAlignment="Top" Width="24" Click="Button_Click"/>
        <Button x:Name="_4" Content="4" HorizontalAlignment="Left" Margin="141,136,0,0" VerticalAlignment="Top" Width="24" Click="Button_Click"/>
        <Button x:Name="_5" Content="5" HorizontalAlignment="Left" Margin="170,136,0,0" VerticalAlignment="Top" Width="24" Click="Button_Click"/>
        <Button x:Name="_1" Content="1" HorizontalAlignment="Left" Margin="141,161,0,0" VerticalAlignment="Top" Width="24" Click="Button_Click"/>
        <Button x:Name="_2" Content="2" HorizontalAlignment="Left" Margin="170,161,0,0" VerticalAlignment="Top" Width="24" Click="Button_Click"/>
        <Button x:Name="_0" Content="0" HorizontalAlignment="Left" Margin="141,186,0,0" VerticalAlignment="Top" Width="24" Click="Button_Click"/>
        <Button x:Name="Dot" Content="." HorizontalAlignment="Left" Margin="170,186,0,0" VerticalAlignment="Top" Width="24" Click="Button_Click"/>
        <Button x:Name="Right_Arrow" Content="&gt;" HorizontalAlignment="Left" Margin="226,97,0,0" VerticalAlignment="Top" Width="24" Click="Button_Click"/>
        <Button x:Name="Backspace" Content="BG" HorizontalAlignment="Left" Margin="255,97,0,0" VerticalAlignment="Top" Width="24" Click="Button_Click"/>
        <Button x:Name="_9" Content="9" HorizontalAlignment="Left" Margin="226,122,0,0" VerticalAlignment="Top" Width="24" Click="Button_Click"/>
        <Button x:Name="Divide" Content="/" HorizontalAlignment="Left" Margin="255,122,0,0" VerticalAlignment="Top" Width="24" Click="Button_Click"/>
        <Button x:Name="_6" Content="6" HorizontalAlignment="Left" Margin="226,146,0,0" VerticalAlignment="Top" Width="24" Click="Button_Click"/>
        <Button x:Name="Multiply" Content="X" HorizontalAlignment="Left" Margin="255,146,0,0" VerticalAlignment="Top" Width="24" Click="Button_Click"/>
        <Button x:Name="_3" Content="3" HorizontalAlignment="Left" Margin="226,171,0,0" VerticalAlignment="Top" Width="24" Click="Button_Click"/>
        <Button x:Name="Minus" Content="-" HorizontalAlignment="Left" Margin="255,171,0,0" VerticalAlignment="Top" Width="24" Click="Button_Click"/>
        <Button x:Name="Equals" Content="=" HorizontalAlignment="Left" Margin="226,196,0,0" VerticalAlignment="Top" Width="24" Click="Button_Click"/>
        <Button x:Name="Plus" Content="+" HorizontalAlignment="Left" Margin="255,196,0,0" VerticalAlignment="Top" Width="24" Click="Button_Click"/>

    </Grid>
</Window>
